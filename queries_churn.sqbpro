<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="data_base.db" readonly="0" foreign_keys="0" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="1504"/><column_width id="4" width="0"/><expanded_item id="0" parent="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="subscription_churn_data" custom_title="0" dock_id="1" table="4,23:mainsubscription_churn_data"/><dock_state state="000000ff00000000fd000000010000000200000161000002acfc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000000001610000015c00ffffff000001610000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="subscription_churn_data" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="54"/><column index="2" value="111"/><column index="3" value="88"/><column index="4" value="108"/><column index="5" value="85"/><column index="6" value="120"/><column index="7" value="117"/><column index="8" value="29"/><column index="9" value="54"/><column index="10" value="70"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1">-- Subscription Churn &amp; Revenue Analysis: SQL queries
-- Database: SQLite (DB Browser for SQLite), table: subscription_churn_data
-- Data: synthetic dataset (2,500 records) generated with Claude (AI) to resemble real subscription behaviour
--
-- Definitions
--   Churn:  no payment within 30 days of the snapshot date (2023-06-30)
--   Tenure: New = joined 90 days or fewer before the snapshot date; Established = more than 90 days
--   Dates are stored as text (MM/DD/YYYY) and converted to YYYY-MM-DD with substr() so julianday() can read them

--Find all Churn customer 
SELECT Churn_Status, COUNT(*) AS customer_count
FROM (
    SELECT 
        User_ID, 
        CASE 
            WHEN julianday('2023-06-30') - julianday(
                substr(Last_Payment_Date, 7, 4) || '-' || 
                substr(Last_Payment_Date, 1, 2) || '-' || 
                substr(Last_Payment_Date, 4, 2)
            ) &gt; 30 
            THEN 'Churned'
            ELSE 'Active'
        END AS Churn_Status
    FROM subscription_churn_data
)
GROUP BY Churn_Status;

--Find Churn customer by Subscription Type
SELECT Subscription_Type, Churn_Status, COUNT(*) AS customer_count
FROM(
	SELECT User_ID, Subscription_Type,
        CASE 
            WHEN julianday('2023-06-30') - julianday(
                substr(Last_Payment_Date, 7, 4) || '-' || 
                substr(Last_Payment_Date, 1, 2) || '-' || 
                substr(Last_Payment_Date, 4, 2)
            ) &gt; 30 
            THEN 'Churned'
            ELSE 'Active'
        END AS Churn_Status
    FROM subscription_churn_data
	)
GROUP BY Subscription_Type, Churn_Status
ORDER BY Subscription_Type;

--Find Churn customer by Plan Duration
SELECT Plan_Duration, Churn_Status, COUNT(*) AS customer_count
FROM(
	SELECT User_ID, Plan_Duration,
        CASE 
            WHEN julianday('2023-06-30') - julianday(
                substr(Last_Payment_Date, 7, 4) || '-' || 
                substr(Last_Payment_Date, 1, 2) || '-' || 
                substr(Last_Payment_Date, 4, 2)
            ) &gt; 30 
            THEN 'Churned'
            ELSE 'Active'
        END AS Churn_Status
    FROM subscription_churn_data
	)
GROUP BY Plan_Duration, Churn_Status
ORDER BY Plan_Duration;

--Find Churn customer by Country
SELECT Country, Churn_Status, COUNT(*) AS customer_count
FROM(
	SELECT User_ID, Country,
        CASE 
            WHEN julianday('2023-06-30') - julianday(
                substr(Last_Payment_Date, 7, 4) || '-' || 
                substr(Last_Payment_Date, 1, 2) || '-' || 
                substr(Last_Payment_Date, 4, 2)
            ) &gt; 30 
            THEN 'Churned'
            ELSE 'Active'
        END AS Churn_Status
    FROM subscription_churn_data
	)
GROUP BY Country, Churn_Status
ORDER BY Country;

--Find Churn customer by Gender
SELECT Gender, Churn_Status, COUNT(*) AS customer_count
FROM(
	SELECT User_ID, Gender,
        CASE 
            WHEN julianday('2023-06-30') - julianday(
                substr(Last_Payment_Date, 7, 4) || '-' || 
                substr(Last_Payment_Date, 1, 2) || '-' || 
                substr(Last_Payment_Date, 4, 2)
            ) &gt; 30 
            THEN 'Churned'
            ELSE 'Active'
        END AS Churn_Status
    FROM subscription_churn_data
	)
GROUP BY Gender, Churn_Status
ORDER BY Gender;

--Find Churn customer by Tenure Segment
SELECT 
    CASE 
        WHEN julianday('2023-06-30') - julianday(
            substr(Join_Date, 7, 4) || '-' || substr(Join_Date, 1, 2) || '-' || substr(Join_Date, 4, 2)
        ) &lt;= 90 
        THEN 'New (&lt;=90 days)'
        ELSE 'Established (&gt;90 days)'
    END AS Tenure_Segment,
    Churn_Status,          
    COUNT(*) AS customer_count
FROM (
    SELECT 
        User_ID,
        Join_Date,         
         CASE 
            WHEN julianday('2023-06-30') - julianday(
                substr(Last_Payment_Date, 7, 4) || '-' || 
                substr(Last_Payment_Date, 1, 2) || '-' || 
                substr(Last_Payment_Date, 4, 2)
            ) &gt; 30 
            THEN 'Churned'
            ELSE 'Active'
        END AS Churn_Status      
    FROM subscription_churn_data
)
GROUP BY Tenure_Segment, Churn_Status;    

--Find Churn customer by Device
SELECT Device, Churn_Status, COUNT(*) AS customer_count
FROM(
	SELECT User_ID, Device,
        CASE 
            WHEN julianday('2023-06-30') - julianday(
                substr(Last_Payment_Date, 7, 4) || '-' || 
                substr(Last_Payment_Date, 1, 2) || '-' || 
                substr(Last_Payment_Date, 4, 2)
            ) &gt; 30 
            THEN 'Churned'
            ELSE 'Active'
        END AS Churn_Status
    FROM subscription_churn_data
	)
GROUP BY Device, Churn_Status
ORDER BY Device;

--Find Churn customer by Age group
SELECT 
	CASE 
		WHEN Age BETWEEN 18 AND 24 THEN '18-24'
		WHEN Age BETWEEN 25 AND 34 THEN '25-34'
		WHEN Age BETWEEN 35 AND 44 THEN '35-44'
		WHEN Age BETWEEN 45 AND 54 THEN '45-54'
		WHEN Age BETWEEN 55 AND 64 THEN '55-64'
		WHEN Age &gt;= 65 THEN '65+'
	END AS Age_Group,
	Churn_Status, COUNT(*) AS customer_count
FROM(
	SELECT User_ID, Age,
        CASE 
            WHEN julianday('2023-06-30') - julianday(
                substr(Last_Payment_Date, 7, 4) || '-' || 
                substr(Last_Payment_Date, 1, 2) || '-' || 
                substr(Last_Payment_Date, 4, 2)
            ) &gt; 30 
            THEN 'Churned'
            ELSE 'Active'
        END AS Churn_Status
    FROM subscription_churn_data
	)
GROUP BY Age_Group, Churn_Status
ORDER BY Age_Group;

-Calculate revenue exposure: active Basic + Monthly customers (count and monthly revenue)
SELECT 
    COUNT(*) AS Risk_customers,
    SUM(Monthly_Revenue) AS Risk_MRR  
FROM (
    SELECT 
        User_ID,
        Monthly_Revenue,
		Subscription_Type,
		Plan_Duration,
        CASE 
            WHEN julianday('2023-06-30') - julianday(
                substr(Last_Payment_Date, 7, 4) || '-' || 
                substr(Last_Payment_Date, 1, 2) || '-' || 
                substr(Last_Payment_Date, 4, 2)
            ) &gt; 30 
            THEN 'Churned'
            ELSE 'Active'
        END AS Churn_Status
    FROM subscription_churn_data
)
WHERE Churn_Status = 'Active' 
AND Subscription_Type = 'Basic'
AND Plan_Duration = 'Monthly';

--Select 3 variables associated with churn (Export this Data to Excel)
SELECT
	User_ID,
	Subscription_Type,
	Plan_Duration,
	Monthly_Revenue,
	CASE
		WHEN julianday('2023-06-30')-julianday(
			substr(Last_Payment_Date, 7, 4) || '-' || 
			substr(Last_Payment_Date, 1, 2) || '-' || 
			substr(Last_Payment_Date, 4, 2)
		) &gt; 30
		THEN 'Churned'
		ELSE 'Active'
	END AS Churn_Status,
	CASE 
        WHEN julianday('2023-06-30') - julianday(
            substr(Join_Date, 7, 4) || '-' || substr(Join_Date, 1, 2) || '-' || substr(Join_Date, 4, 2)
        ) &lt;= 90 
        THEN 'New (&lt;=90 days)'
        ELSE 'Established (&gt;90 days)'
    END AS Tenure_Segment
FROM subscription_churn_data;</sql><current_tab id="0"/></tab_sql></sqlb_project>
